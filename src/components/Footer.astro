---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer
  class="relative z-10 w-full px-5 pt-5 pb-8 text-center text-white"
>
  <!-- Gradient top border -->
  <div class="mx-auto mb-6 h-px max-w-xl" style="background: linear-gradient(to right, transparent, rgba(16, 185, 129, 0.3), transparent);"></div>

  <ul class="mb-5 flex flex-wrap justify-center gap-x-5 text-xs">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
            href={href}
            target={href.startsWith("mailto:") ? "_self" : "_blank"}
            class="inline-block px-4 py-3 transition-colors duration-300 hover:text-primary"
          >
            {text}
            {!href.startsWith("mailto:") && (
              <span class="relative -bottom-1 ml-1 inline-block">
                <img src="/external.svg" alt="" class="inline h-3 w-3" />
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="text-xs">
    {author} © {currentYear}. <span class="text-neutral"
      >Basado en</span
    > <a href="https://github.com/immois/astro-zen" target="_blank" class="text-primary/60 transition-colors hover:text-primary">astro-zen</a> <span class="text-neutral">por</span> Moisés Machuca
  </p>
</footer>
