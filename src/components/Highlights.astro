---
import Section from "./Section.astro";
import type { HighlightGroup } from "@types";

interface Props {
  highlights: HighlightGroup[];
}

const { highlights } = Astro.props;
---

<Section text="Trayectoria" href="highlights">
  <div class="grid gap-6 sm:grid-cols-2">
    {
      highlights.map(({ icon, title, items }) => (
        <div class="glass-card-hover p-6">
          <h3 class="mb-4 flex items-center gap-2 font-serif text-lg font-semibold text-primary">
            <span class="text-xl">{icon}</span>
            {title}
          </h3>
          <ul class="space-y-3">
            {items.map(({ text, link }) => (
              <li class="flex items-start gap-2 text-sm leading-relaxed text-neutral">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/40"></span>
                <div class="flex flex-col gap-1.5">
                  <span>{text}</span>
                  {link && (
                    <a
                      href={link}
                      target="_blank"
                      class="glass-badge inline-flex w-fit items-center gap-1.5 px-3 py-1 text-xs font-medium text-primary-light"
                    >
                      📄 Ver documento
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
